#!/usr/bin/env python3
"""Synthetic ball feed for planner/runner testing WITHOUT motion capture.

Publishes ``/poses`` (geometry_msgs/PoseArray, ball at index 0 — the
hope_planner input contract) at ``rate_hz``, simulating serves toward the robot
with the same quadratic-drag + table-bounce model the planner assumes.
Alternates a forehand-side and a backhand-side serve.

IMPORTANT: ``drag_k`` / ``restitution_*`` here should match the planner's ball
physics (configs/ball_physics.yaml) so the planner's predictions track the
simulated ball. Positions are in the table frame (z = 0 at the table surface).
"""

# =============================================================================
# 【中文说明】合成球发布器：无动捕时用它发 /poses，做规划器/整链路冒烟测试
# -----------------------------------------------------------------------------
#   以 rate_hz 发布 /poses(PoseArray，球在 index 0)，用与规划器同一套“二次阻力+桌面弹跳”
#   物理正向仿真一次次发球（默认在正手/反手两种发球间交替，也可用 serves 给出扫描序列）。
#   重要：这里的 drag_k / restitution_* / ball_radius 必须与规划器的 ball_physics.yaml 一致，
#         否则规划器的预测追不上仿真球，测出的行为不可信。
#   坐标系：桌面系，z=0 为桌面；球“心”落到 z=ball_radius 视为触桌反弹（与预测器约定一致）。
#   结束条件：球越过机器人(end_x)、掉到地面以下、或飞行超时 → 暂停 pause_s 后发下一球；
#             max_serves>0 时发满该数量即空转停止。
# =============================================================================

import numpy as np
import rclpy
from geometry_msgs.msg import Pose, PoseArray
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy


class FakeBallPublisher(Node):
    def __init__(self):
        super().__init__("fake_ball_publisher")
        # serve = [px, py, pz, vx, vy, vz] in the table frame (z = 0 at the surface).
        self.declare_parameter("serve_forehand", [2.3, -1.00, 0.40, -5.0, 0.2, 1.0])
        self.declare_parameter("serve_backhand", [2.3, -0.52, 0.40, -5.0, -0.2, 1.0])
        # Optional serve sweep: a flat N*6 list of serves cycled in order. When set
        # (length >= 6 and a multiple of 6) it replaces the two-serve alternation.
        # The [0.0] default is a "not set" sentinel (rclpy cannot infer a
        # DOUBLE_ARRAY from an empty list); any length < 6 keeps the legacy pair.
        self.declare_parameter("serves", [0.0])
        self.declare_parameter("rate_hz", 300.0)
        self.declare_parameter("drag_k", 0.1261)        # match the planner's drag
        self.declare_parameter("restitution_h", 0.63)   # match the planner's table tangential retention
        self.declare_parameter("restitution_v", 0.92)   # match the planner's table normal restitution
        self.declare_parameter("ball_radius", 0.020)    # m; centroid contacts the table at z = radius
        self.declare_parameter("table_x_max", 2.74)     # bounce only over the table
        self.declare_parameter("end_x", -0.6)           # serve ends past the robot
        self.declare_parameter("pause_s", 1.0)          # gap between serves
        self.declare_parameter("max_flight_s", 3.0)
        # 0 preserves the infinite cycle; set to an exact serve count to stop after it.
        self.declare_parameter("max_serves", 0)
        self.declare_parameter("frame_id", "world")

        # 发球序列：若 serves 参数给了 N*6 的扁平列表则按它循环；否则退回“正手/反手”两球交替。
        gp = self.get_parameter
        sweep = [float(v) for v in gp("serves").value]
        if len(sweep) >= 6 and len(sweep) % 6 == 0:
            self._serves = [np.array(sweep[i:i + 6]) for i in range(0, len(sweep), 6)]
        else:
            self._serves = [
                np.array([float(v) for v in gp("serve_forehand").value]),
                np.array([float(v) for v in gp("serve_backhand").value]),
            ]
        self._dt = 1.0 / max(float(gp("rate_hz").value), 1.0)
        self._k = float(gp("drag_k").value)
        self._ch = float(gp("restitution_h").value)
        self._cv = float(gp("restitution_v").value)
        self._radius = float(gp("ball_radius").value)
        self._x_max = float(gp("table_x_max").value)
        self._end_x = float(gp("end_x").value)
        self._pause_len = float(gp("pause_s").value)
        self._max_flight = float(gp("max_flight_s").value)
        self._max_serves = max(int(gp("max_serves").value), 0)
        self._frame = str(gp("frame_id").value)
        self._g = np.array([0.0, 0.0, -9.81])

        qos = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT,
                         durability=DurabilityPolicy.VOLATILE,
                         history=HistoryPolicy.KEEP_LAST, depth=1)
        self._pub = self.create_publisher(PoseArray, "/poses", qos)
        self._serve_i = 0
        self._pause = 0.0
        self._finished = False
        self._reset()
        self.create_timer(self._dt, self._tick)
        self.get_logger().info(
            f"fake ball @{1.0/self._dt:.0f} Hz, drag_k={self._k}, "
            f"serves={[' '.join(f'{v:+.2f}' for v in s) for s in self._serves]}, "
            f"max_serves={self._max_serves or 'unlimited'}")

    def _reset(self):
        # 开始下一次发球：达到 max_serves 则收工空转；否则取下一条发球初值(位置+速度)、清飞行时。
        if self._max_serves and self._serve_i >= self._max_serves:
            self._finished = True
            self.get_logger().info(
                f"completed configured max_serves={self._max_serves}; publisher idle")
            return
        s = self._serves[self._serve_i % len(self._serves)]
        self._serve_i += 1
        self._p = s[:3].copy()   # 初始位置 [x,y,z]
        self._v = s[3:].copy()   # 初始速度 [vx,vy,vz]
        self._t = 0.0
        self.get_logger().info(
            f"serve {self._serve_i}: p={np.round(self._p, 2).tolist()} v={np.round(self._v, 2).tolist()}")

    def _tick(self):
        # 定时器回调：一步物理积分 + 弹跳/结束判定 + 发一帧球位。
        if self._finished:
            return
        # 发球间隔：暂停计时结束后触发下一次发球。
        if self._pause > 0.0:
            self._pause -= self._dt
            if self._pause <= 0.0:
                self._reset()
            return
        # 一步显式欧拉：加速度 = 二次阻力 + 重力，更新速度与位置。
        self._t += self._dt
        a = -self._k * np.linalg.norm(self._v) * self._v + self._g
        self._v = self._v + a * self._dt
        self._p = self._p + self._v * self._dt
        # 桌面弹跳：球心落到 z=球半径、正在下落且在桌面 x 范围内 → 反弹
        # （切向乘 C_h 衰减、法向乘 -C_v 反弹；与规划器预测器/ball_physics.yaml 同一约定）。
        if self._p[2] <= self._radius and self._v[2] < 0.0 and 0.0 <= self._p[0] <= self._x_max:
            self._p[2] = self._radius
            self._v[0] *= self._ch
            self._v[1] *= self._ch
            self._v[2] = -self._cv * self._v[2]
        # 结束条件：越过机器人(end_x)/掉出地面/飞行超时 → 进入发球间隔，本帧不发。
        if self._p[0] < self._end_x or self._p[2] < -0.7 or self._t > self._max_flight:
            self._pause = self._pause_len
            return
        # 正常帧：组一条 PoseArray（球在 index 0），时间戳用当前 ROS 时钟。
        msg = PoseArray()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = self._frame
        pose = Pose()
        pose.position.x, pose.position.y, pose.position.z = self._p.tolist()
        pose.orientation.w = 1.0
        msg.poses = [pose]
        self._pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = FakeBallPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
